# VoiceShield AI Backend Environment Configuration
APP_NAME="VoiceShield AI Backend Engine"
DEBUG=true
PORT=8000

# Database: SQLite for local dev fallback, PostgreSQL for production deployment
# Example PostgreSQL: postgresql://user:password@localhost:5432/voiceshield_db
DATABASE_URL="sqlite:///./voiceshield.db"

# Hardware Device Selection: "auto" | "cpu" | "cuda"
MODEL_DEVICE="auto"

# Model Cache & Weights Directory
MODEL_CACHE_DIR="./models_cache"

# Security & CORS
SECRET_KEY="voiceshield_sih_2026_super_secret_key"
CORS_ORIGINS=["*"]

# Dynamic Risk Engine Default Formula Weights (Sum = 100%)
WEIGHT_SYNTHETIC=40.0
WEIGHT_SPEAKER=25.0
WEIGHT_LIVENESS=15.0
WEIGHT_CONTEXT=10.0
WEIGHT_TRANSACTION=10.0
